package-as: isiLive
enable-nolib-creation: no
manual-changelog:
  filename: CHANGELOG_RELEASE.md
  markup-type: markdown
ignore:
  - .github
  - .githooks
  - .vscode
  - .claude
  - .gitattributes
  - .editorconfig
  - .luacheckrc
  - .stylua.toml
  - .styluaignore
  - .luarocks
  - .luacov
  - .gitignore
  - docs
  - README.md
  - SECURITY.md
  - AGENTS.md
  - CLAUDE.md
  - TODO.md
  - tools
  - testmodul
  - luacheck_output.txt
  - isiLive.png
  - isiLive_*.png
  - isiLive_*.gif
  - isiLive_*.mp4
